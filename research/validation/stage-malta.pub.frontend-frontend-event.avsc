{
  "fields": [
    {
      "doc": "Logical channel identifier for the event. Pattern is <event type>.<id>",
      "name": "channel",
      "type": {
        "avro.java.string": "String",
        "type": "string"
      }
    },
    {
      "doc": "Event type name, e.g.'SessionEnded'",
      "name": "eventType",
      "type": {
        "avro.java.string": "String",
        "type": "string"
      }
    },
    {
      "doc": "Event specific payload. Determined by the event type",
      "name": "event",
      "type": [
        {
          "doc": "Published after a players login session is ended. Either through expiry or explicit logout",
          "fields": [
            {
              "doc": "Session details",
              "name": "session",
              "type": {
                "fields": [
                  {
                    "doc": "Unique player identifier",
                    "name": "playerUid",
                    "type": {
                      "avro.java.string": "String",
                      "type": "string"
                    }
                  },
                  {
                    "doc": "Unique session identifier",
                    "name": "sessionUid",
                    "type": {
                      "avro.java.string": "String",
                      "type": "string"
                    }
                  },
                  {
                    "doc": "Session channel. One of 'IPAD', 'BACKOFFICE', 'ANDROID', 'DESKTOP', 'IPHONE', 'WINDOWS_PHONE'",
                    "name": "channelUid",
                    "type": {
                      "avro.java.string": "String",
                      "type": "string"
                    }
                  },
                  {
                    "doc": "Session start time in epoch millis UTC",
                    "name": "startedTimestamp",
                    "type": {
                      "logicalType": "timestamp-millis",
                      "type": "long"
                    }
                  },
                  {
                    "doc": "Session end time in epoch millis UTC",
                    "name": "endedTimestamp",
                    "type": [
                      "null",
                      {
                        "logicalType": "timestamp-millis",
                        "type": "long"
                      }
                    ]
                  }
                ],
                "name": "Session",
                "type": "record"
              }
            },
            {
              "doc": "Reason for session end. One of 'Logout', 'Limit', 'Expired'",
              "name": "endReason",
              "type": {
                "avro.java.string": "String",
                "type": "string"
              }
            }
          ],
          "name": "SessionEnded",
          "type": "record"
        },
        {
          "doc": "Published when a player deposit have been approved",
          "fields": [
            {
              "doc": "Payment details",
              "name": "payment",
              "type": {
                "fields": [
                  {
                    "doc": "Unique internal player identifier",
                    "name": "playerUid",
                    "type": {
                      "avro.java.string": "String",
                      "type": "string"
                    }
                  },
                  {
                    "doc": "Unique internal payment identifier",
                    "name": "paymentUid",
                    "type": {
                      "avro.java.string": "String",
                      "type": "string"
                    }
                  },
                  {
                    "doc": "Init payment method details",
                    "name": "initMethod",
                    "type": {
                      "fields": [
                        {
                          "doc": "Unique internal method identifier",
                          "name": "methodUid",
                          "type": {
                            "avro.java.string": "String",
                            "type": "string"
                          }
                        },
                        {
                          "doc": "External method identifier (unique per provider)",
                          "name": "externalId",
                          "type": {
                            "avro.java.string": "String",
                            "type": "string"
                          }
                        },
                        {
                          "name": "provider",
                          "type": {
                            "fields": [
                              {
                                "doc": "Unique internal PSP provider identifier",
                                "name": "providerUid",
                                "type": {
                                  "avro.java.string": "String",
                                  "type": "string"
                                }
                              },
                              {
                                "doc": "External method identifier (unique per provider)",
                                "name": "externalId",
                                "type": {
                                  "avro.java.string": "String",
                                  "type": "string"
                                }
                              }
                            ],
                            "name": "PaymentProvider",
                            "type": "record"
                          }
                        }
                      ],
                      "name": "PaymentMethod",
                      "type": "record"
                    }
                  },
                  {
                    "doc": "Payment method details",
                    "name": "method",
                    "type": "PaymentMethod"
                  },
                  {
                    "doc": "Internally generated external payment reference",
                    "name": "externalReference",
                    "type": {
                      "avro.java.string": "String",
                      "type": "string"
                    }
                  },
                  {
                    "doc": "PSP unique payment reference",
                    "name": "pspReference",
                    "type": [
                      "null",
                      {
                        "avro.java.string": "String",
                        "type": "string"
                      }
                    ]
                  },
                  {
                    "doc": "Payment creation time in epoch millis UTC",
                    "name": "createdTimestamp",
                    "type": {
                      "logicalType": "timestamp-millis",
                      "type": "long"
                    }
                  },
                  {
                    "doc": "Decimal payment amount, e.g. 200.00",
                    "name": "amount",
                    "type": {
                      "avro.java.string": "String",
                      "type": "string"
                    }
                  },
                  {
                    "doc": "ISO 4217 currency code",
                    "name": "currencyUid",
                    "type": {
                      "avro.java.string": "String",
                      "type": "string"
                    }
                  }
                ],
                "name": "Payment",
                "type": "record"
              }
            }
          ],
          "name": "DepositApproved",
          "type": "record"
        },
        {
          "doc": "Published when a player deposit have been denied",
          "fields": [
            {
              "doc": "Payment details",
              "name": "payment",
              "type": "Payment"
            }
          ],
          "name": "DepositDenied",
          "type": "record"
        },
        {
          "doc": "Published when a player withdrawal have been approved",
          "fields": [
            {
              "doc": "Payment details",
              "name": "payment",
              "type": "Payment"
            }
          ],
          "name": "WithdrawalApproved",
          "type": "record"
        },
        {
          "doc": "Published when a player withdrawal have been denied",
          "fields": [
            {
              "doc": "Payment details",
              "name": "payment",
              "type": "Payment"
            }
          ],
          "name": "WithdrawalDenied",
          "type": "record"
        },
        {
          "doc": "Published when a player's permissions has changed",
          "fields": [
            {
              "doc": "Updated list of current permissions for the player",
              "name": "permissions",
              "type": {
                "items": {
                  "fields": [
                    {
                      "doc": "Unique permission name",
                      "name": "permission",
                      "type": {
                        "avro.java.string": "String",
                        "type": "string"
                      }
                    },
                    {
                      "doc": "Current permission grant status",
                      "name": "granted",
                      "type": "boolean"
                    }
                  ],
                  "name": "Permission",
                  "type": "record"
                },
                "type": "array"
              }
            },
            {
              "doc": "List of permissions affected by this change (may be empty)",
              "name": "updatedPermissions",
              "type": {
                "items": "Permission",
                "type": "array"
              }
            }
          ],
          "name": "PermissionsChanged",
          "type": "record"
        },
        {
          "doc": "Published when there is a change in a BlueRibbon jackpot",
          "fields": [
            {
              "doc": "Jackpot game identifier",
              "name": "jackpotGameId",
              "type": {
                "avro.java.string": "String",
                "type": "string"
              }
            },
            {
              "doc": "Last change time in epoch millis UTC",
              "name": "lastWinnersChangeTimestamp",
              "type": {
                "logicalType": "timestamp-millis",
                "type": "long"
              }
            },
            {
              "doc": "List of jackpot pots",
              "name": "pots",
              "type": {
                "items": {
                  "fields": [
                    {
                      "doc": "Jackpot pot id",
                      "name": "potId",
                      "type": {
                        "avro.java.string": "String",
                        "type": "string"
                      }
                    },
                    {
                      "doc": "Pot name",
                      "name": "name",
                      "type": {
                        "avro.java.string": "String",
                        "type": "string"
                      }
                    },
                    {
                      "doc": "Pot status, one of 'COLD', 'CHILLY', 'WARM', 'HOT'",
                      "name": "status",
                      "type": {
                        "avro.java.string": "String",
                        "type": "string"
                      }
                    },
                    {
                      "doc": "Last change time in epoch millis UTC",
                      "name": "lastChangeTimestamp",
                      "type": {
                        "logicalType": "timestamp-millis",
                        "type": "long"
                      }
                    },
                    {
                      "name": "amounts",
                      "type": {
                        "items": {
                          "fields": [
                            {
                              "doc": "Decimal amount (variable point), e.g. 200.00 or 200.1234",
                              "name": "amount",
                              "type": {
                                "avro.java.string": "String",
                                "type": "string"
                              }
                            },
                            {
                              "doc": "ISO 4217 currency code",
                              "name": "currencyUid",
                              "type": {
                                "avro.java.string": "String",
                                "type": "string"
                              }
                            }
                          ],
                          "name": "BlueRibbonJackpotPotAmount",
                          "type": "record"
                        },
                        "type": "array"
                      }
                    }
                  ],
                  "name": "LeoJackpotPot",
                  "type": "record"
                },
                "type": "array"
              }
            },
            {
              "default": null,
              "doc": "Jackpot variant identifier",
              "name": "jackpotVariant",
              "type": [
                "null",
                {
                  "avro.java.string": "String",
                  "type": "string"
                }
              ]
            },
            {
              "default": null,
              "doc": "Jackpot information related to time limited jackpots",
              "name": "dropInformation",
              "type": [
                "null",
                {
                  "fields": [
                    {
                      "default": null,
                      "doc": "Jackpot will drop before this timestamp",
                      "name": "willDropBeforeTimestamp",
                      "type": [
                        "null",
                        "long"
                      ]
                    },
                    {
                      "default": null,
                      "doc": "Last timestamp this jackpot dropped",
                      "name": "previousDropTimestamp",
                      "type": [
                        "null",
                        "long"
                      ]
                    },
                    {
                      "default": null,
                      "doc": "Percentage from last drop to next drop, can be > 100.00",
                      "name": "timeToDropPercentage",
                      "type": [
                        "null",
                        {
                          "avro.java.string": "String",
                          "type": "string"
                        }
                      ]
                    }
                  ],
                  "name": "DropInformation",
                  "type": "record"
                }
              ]
            },
            {
              "default": null,
              "doc": "All games in the same jackpot",
              "name": "gamesInJackpot",
              "type": [
                "null",
                {
                  "items": {
                    "avro.java.string": "String",
                    "type": "string"
                  },
                  "type": "array"
                }
              ]
            }
          ],
          "name": "BlueRibbonJackpotUpdated",
          "type": "record"
        },
        {
          "doc": "Published when there is a BlueRibbon jackpot win",
          "fields": [
            {
              "doc": "Jackpot game identifier",
              "name": "jackpotGameId",
              "type": {
                "avro.java.string": "String",
                "type": "string"
              }
            },
            {
              "doc": "Unique internal player identifier",
              "name": "playerUid",
              "type": {
                "avro.java.string": "String",
                "type": "string"
              }
            },
            {
              "doc": "Jackpot event identifier",
              "name": "eventId",
              "type": {
                "avro.java.string": "String",
                "type": "string"
              }
            },
            {
              "doc": "Jackpot game identifier",
              "name": "gameId",
              "type": {
                "avro.java.string": "String",
                "type": "string"
              }
            },
            {
              "doc": "Jackpot brand identifier",
              "name": "brand",
              "type": {
                "avro.java.string": "String",
                "type": "string"
              }
            },
            {
              "doc": "Jackpot type, one of 'PUBLIC', 'PRIVATE'",
              "name": "jackpotType",
              "type": {
                "avro.java.string": "String",
                "type": "string"
              }
            },
            {
              "doc": "Jackpot seed",
              "name": "seed",
              "type": {
                "avro.java.string": "String",
                "type": "string"
              }
            },
            {
              "doc": "Jackpot name",
              "name": "name",
              "type": {
                "avro.java.string": "String",
                "type": "string"
              }
            },
            {
              "doc": "Jackpot win time in epoch millis UTC",
              "name": "winTimestamp",
              "type": {
                "logicalType": "timestamp-millis",
                "type": "long"
              }
            },
            {
              "name": "amounts",
              "type": {
                "items": "BlueRibbonJackpotPotAmount",
                "type": "array"
              }
            },
            {
              "default": null,
              "doc": "Jackpot variant identifier",
              "name": "jackpotVariant",
              "type": [
                "null",
                {
                  "avro.java.string": "String",
                  "type": "string"
                }
              ]
            },
            {
              "default": null,
              "doc": "All games in the same jackpot",
              "name": "gamesInJackpot",
              "type": [
                "null",
                {
                  "items": {
                    "avro.java.string": "String",
                    "type": "string"
                  },
                  "type": "array"
                }
              ]
            }
          ],
          "name": "BlueRibbonJackpotWin",
          "type": "record"
        },
        {
          "doc": "User messages Published when there is a BlueRibbon jackpot win",
          "fields": [
            {
              "doc": "unique identifier of the event",
              "name": "uid",
              "type": {
                "avro.java.string": "String",
                "type": "string"
              }
            },
            {
              "doc": "time in epoch millis UTC",
              "name": "timestamp",
              "type": {
                "logicalType": "timestamp-millis",
                "type": "long"
              }
            },
            {
              "doc": "player identifier by playerUid",
              "name": "context",
              "type": {
                "avro.java.string": "String",
